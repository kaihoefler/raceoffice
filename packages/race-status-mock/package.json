{
  "name": "@raceoffice/race-status-mock",
  "version": "0.1.0",
  "private": true,
  "description": "Controllable mock and recorder for the timing system's live race status feed (tests, manual testing).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@raceoffice/domain": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
